<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoidNote.App.ViewModels"
        xmlns:projects="using:VoidNote.Domain.Projects"
        xmlns:shawzin="using:VoidNote.Domain.Shawzin"
        xmlns:profiles="using:VoidNote.GameBridge.Profiles"
        xmlns:ensemble="using:VoidNote.Shawzin.Ensemble"
        xmlns:views="using:VoidNote.App.Views"
        x:Class="VoidNote.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource AppName}"
        Width="1100" Height="720" MinWidth="820" MinHeight="560">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,18" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel>
          <TextBlock Text="{DynamicResource AppName}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ProjectName}" Opacity="0.8" />
          <TextBlock Text="{Binding ProjectState}" Opacity="0.65" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ActiveJobs}" Margin="12" VerticalAlignment="Center" />
        <Border Grid.Column="2" Padding="12,6" CornerRadius="12" Background="{DynamicResource SystemAccentColor}">
          <TextBlock Text="{Binding ApplicationVersion}" Foreground="White" />
        </Border>
      </Grid>
    </Border>
    <TabControl Grid.Row="1">
      <TabItem Header="{DynamicResource WorkspaceProject}">
        <ScrollViewer>
          <Grid Margin="28" ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="14">
              <TextBlock Text="{DynamicResource AppName}" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource NoCloud}" TextWrapping="Wrap" FontSize="16" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Content="{DynamicResource NewProject}" Click="NewProject_Click" />
                <Button Grid.Column="1" Content="{DynamicResource OpenProject}" Click="OpenProject_Click" />
                <Button Grid.Column="2" Content="{DynamicResource SaveProject}" Click="SaveProject_Click" ToolTip.Tip="Ctrl+S" />
              </Grid>
              <TextBlock Text="{DynamicResource ProjectName}" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ProjectNameDraft}" MaxLength="{Binding ProjectNameMaximumLength}" />
                <Button Grid.Column="1" Content="{DynamicResource ApplyProjectName}" Click="RenameProject_Click" IsEnabled="{Binding IsProjectNameValid}" />
              </Grid>
              <TextBlock Text="{DynamicResource ProjectNameEmpty}" Foreground="Crimson" IsVisible="{Binding IsProjectNameEmpty}" />
              <TextBlock Text="{DynamicResource ProjectNameHelp}" Opacity="0.7" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Content="{DynamicResource Undo}" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Ctrl+Z" />
                <Button Grid.Column="1" Content="{DynamicResource Redo}" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Ctrl+Y" />
              </Grid>
              <TextBlock Text="{DynamicResource ProjectPath}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource ProjectStatus}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ProjectState}" />
              <Border IsVisible="{Binding HasPendingRecovery}" Padding="16" BorderThickness="2" BorderBrush="{DynamicResource SystemAccentColor}" CornerRadius="8">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource Recovery}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource RecoveryHelp}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PendingRecovery.ProjectName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PendingRecovery.OriginalProjectPath}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource ProjectId}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding PendingRecovery.ProjectId}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource AutosaveTime}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding PendingRecoveryAutosavedAt}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="{DynamicResource Recover}" Click="Recover_Click"/><Button Grid.Column="1" Content="{DynamicResource Discard}" Click="DiscardRecovery_Click"/></Grid>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock Text="{DynamicResource RecentProjects}" FontSize="22" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedRecentProject}" MinHeight="300">
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:RecentProjectViewModel"><Border Padding="10"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="{Binding LastOpened}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Availability}" Margin="10"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Content="{DynamicResource OpenSelected}" Click="OpenRecent_Click" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource WorkspaceAudio}">
        <views:AudioLabView DataContext="{Binding AudioLab}" />
      </TabItem>
      <TabItem Header="{DynamicResource WorkspaceMidi}">
        <Grid Margin="28" RowDefinitions="Auto,Auto,*" RowSpacing="14">
          <TextBlock Text="{DynamicResource WorkspaceMidi}" FontSize="24" FontWeight="SemiBold" />
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Content="{DynamicResource OpenMidi}" Click="OpenMidi_Click" ToolTip.Tip="Ctrl+O" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="projects:MidiTrack">
                <Grid Margin="8" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Events.Count}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource WorkspaceShawzin}">
    <ScrollViewer>
      <Grid Margin="28" ColumnDefinitions="320,*" ColumnSpacing="28">
        <StackPanel Spacing="12">
          <Button Content="{DynamicResource OpenMidi}" Click="OpenMidi_Click" ToolTip.Tip="Ctrl+O" />
          <TextBlock Text="{DynamicResource Track}" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="projects:MidiTrack"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{DynamicResource Instrument}" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="shawzin:ShawzinDefinition"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{DynamicResource Scale}" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" />
          <TextBlock Text="{DynamicResource ArrangementStrategy}" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:StrategyChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Content="{DynamicResource Analyze}" Click="Analyze_Click" />
            <Button Grid.Column="1" Content="{DynamicResource Arrange}" Click="Arrange_Click" />
          </Grid>
          <Button Content="{DynamicResource SavePreview}" IsEnabled="{Binding HasPreview}" Click="SavePreview_Click" />
          <Border Padding="12" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{DynamicResource SystemAccentColor}">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource MultiShawzin}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource ShawzinCount}" />
              <ComboBox ItemsSource="{Binding ShawzinCounts}" SelectedItem="{Binding ShawzinCount}" />
              <TextBlock Text="{DynamicResource SplitStrategy}" />
              <ComboBox ItemsSource="{Binding SplitStrategies}" SelectedItem="{Binding SplitStrategy}" />
              <Button Content="{DynamicResource SplitArrange}" Click="SplitEnsemble_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="14">
          <TextBlock Text="{DynamicResource Compatibility}" FontSize="20" FontWeight="SemiBold" />
          <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="{DynamicResource GeneratedCode}" FontSize="20" FontWeight="SemiBold" />
          <TextBox Text="{Binding SongCode}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
          <Button Content="{DynamicResource CopyCode}" HorizontalAlignment="Left" Click="CopyCode_Click" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75" />
          <Expander Header="{DynamicResource ValidationTool}">
            <StackPanel Spacing="8">
              <TextBox PlaceholderText="{DynamicResource PasteCode}" Text="{Binding ValidationCode}" AcceptsReturn="True" MinHeight="80" />
              <Button Content="{DynamicResource DecodeValidate}" Click="ValidateCode_Click" />
              <TextBox Text="{Binding ValidationReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
              <TextBlock Text="{DynamicResource MappingValidation}" FontWeight="SemiBold" />
              <Button Content="{DynamicResource GenerateTestSequence}" Click="GenerateMapping_Click" />
              <TextBox Text="{Binding MappingSequence}" IsReadOnly="True" AcceptsReturn="True" MinHeight="150" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="{DynamicResource ConfirmMapping}" Click="ConfirmMapping_Click"/><Button Grid.Column="1" Content="{DynamicResource SaveUnconfirmed}" Click="SaveUnconfirmedMapping_Click"/></Grid>
            </StackPanel>
          </Expander>
          <TextBlock Text="{DynamicResource EnsembleTracks}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EnsembleReport}" TextWrapping="Wrap" />
          <Expander Header="{DynamicResource SplitReport}">
            <TextBox Text="{Binding EnsembleDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" />
          </Expander>
          <ListBox ItemsSource="{Binding EnsembleTracks}" SelectedItem="{Binding SelectedEnsembleTrack}" MaxHeight="420">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EnsembleTrackViewModel">
                <Border Padding="10" Margin="0,3" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding Instrument}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="shawzin:ShawzinDefinition"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:StrategyChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="Auto,80,Auto,Auto,*" ColumnSpacing="8">
                      <TextBlock Text="{DynamicResource Transpose}" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding Transposition}" />
                      <CheckBox Grid.Column="2" Content="{DynamicResource Mute}" IsChecked="{Binding IsMuted}" />
                      <CheckBox Grid.Column="3" Content="{DynamicResource Solo}" IsChecked="{Binding IsSolo}" />
                      <TextBlock Grid.Column="4" Text="{Binding Compatibility, StringFormat='Compatibility {0}/100'}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Report}" />
                    <TextBox Text="{Binding Code}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Padding="16" Margin="0,16,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemAccentColor}">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource IngamePlayback}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GameBridgeAvailability}" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource KeybindProfile}" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding KeybindProfiles}" SelectedItem="{Binding SelectedKeybindProfile}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="profiles:ShawzinKeybindProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox PlaceholderText="{DynamicResource ProfileName}" Text="{Binding ProfileName}" />
              <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Text="{DynamicResource String1}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding String1Key}" />
                <TextBlock Grid.Column="2" Text="{DynamicResource FretLeft}" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding FretLeftKey}" />
                <TextBlock Grid.Row="1" Text="{DynamicResource String2}" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding String2Key}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource FretMiddle}" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding FretMiddleKey}" />
                <TextBlock Grid.Row="2" Text="{DynamicResource String3}" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding String3Key}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource FretRight}" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding FretRightKey}" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Content="{DynamicResource SaveProfile}" Click="SaveProfile_Click" />
                <Button Grid.Column="1" Content="{DynamicResource Duplicate}" Click="DuplicateProfile_Click" />
                <Button Grid.Column="2" Content="{DynamicResource Delete}" Click="DeleteProfile_Click" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Content="{DynamicResource Arm}" Click="Arm_Click" />
                <Button Grid.Column="1" Content="{DynamicResource Disarm}" Click="Disarm_Click" />
                <Button Grid.Column="2" Content="{DynamicResource DryRun}" Click="DryRun_Click" />
              </Grid>
              <Button Content="{DynamicResource DiagnosticInput}" Click="TestInput_Click" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Content="{DynamicResource Start}" Click="StartIngame_Click" />
                <Button Grid.Column="1" Content="{DynamicResource Stop}" Click="Disarm_Click" />
              </Grid>
              <Button Content="{DynamicResource EmergencyStop}" Background="#B3261E" Foreground="White" Click="EmergencyStop_Click" />
              <TextBlock Text="{DynamicResource EmergencyHelp}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding GameBridgeStatus}" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource WorkspaceCreator}">
        <views:CreatorModeView DataContext="{Binding CreatorMode}" />
      </TabItem>
      <TabItem Header="{DynamicResource WorkspaceMandachord}">
        <views:MandachordStudioView DataContext="{Binding MandachordStudio}" />
      </TabItem>
      <TabItem Header="{DynamicResource WorkspaceSettings}">
        <ScrollViewer><Grid Margin="28" ColumnDefinitions="340,*" ColumnSpacing="28">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource WorkspaceSettings}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Language}"/><ComboBox ItemsSource="{Binding Cultures}" SelectedItem="{Binding SelectedCulture}"/>
            <TextBlock Text="{DynamicResource Theme}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
            <TextBlock Text="{DynamicResource Autosave}"/><ComboBox ItemsSource="{Binding AutosaveIntervals}" SelectedItem="{Binding SelectedAutosaveInterval}"/>
            <Button Content="{DynamicResource SaveSettings}" Click="SaveSettings_Click"/>
            <TextBlock Text="{DynamicResource About}" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBlock Text="{Binding ApplicationVersion}" />
            <TextBlock Text="{DynamicResource IndependentNotice}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource ThirdPartyRisk}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource License}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Text="{DynamicResource DependencyCenter}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource FfmpegPath}"/><TextBox Text="{Binding FfmpegPath}"/>
            <TextBlock Text="{DynamicResource FfplayPath}"/><TextBox Text="{Binding FfplayPath}"/>
            <TextBlock Text="{DynamicResource PythonPath}"/><TextBox Text="{Binding PythonPath}"/>
            <TextBlock Text="{DynamicResource WorkerPath}"/><TextBox Text="{Binding WorkerPath}"/>
            <TextBlock Text="{DynamicResource DependencyRestart}" TextWrapping="Wrap" Opacity="0.7"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="{DynamicResource RefreshDiagnostics}" Click="Diagnostics_Click"/><Button Grid.Column="1" Content="{DynamicResource ExportDiagnostics}" Click="ExportDiagnostics_Click"/></Grid>
            <TextBox Text="{Binding DiagnosticsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="480" FontFamily="Consolas,monospace"/>
          </StackPanel>
        </Grid></ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
