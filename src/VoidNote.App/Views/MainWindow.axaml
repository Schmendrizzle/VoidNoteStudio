<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoidNote.App.ViewModels"
        xmlns:projects="using:VoidNote.Domain.Projects"
        xmlns:shawzin="using:VoidNote.Domain.Shawzin"
        xmlns:profiles="using:VoidNote.GameBridge.Profiles"
        xmlns:ensemble="using:VoidNote.Shawzin.Ensemble"
        xmlns:views="using:VoidNote.App.Views"
        x:Class="VoidNote.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource AppName}"
        Width="1100" Height="720" MinWidth="820" MinHeight="560">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,18" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{DynamicResource AppName}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Shawzin Studio" Opacity="0.7" />
        </StackPanel>
        <Border Grid.Column="1" Padding="12,6" CornerRadius="12" Background="{DynamicResource SystemAccentColor}">
          <TextBlock Text="{DynamicResource MilestoneLabel}" Foreground="White" />
        </Border>
      </Grid>
    </Border>
    <TabControl Grid.Row="1">
      <TabItem Header="Audio Lab">
        <views:AudioLabView DataContext="{Binding AudioLab}" />
      </TabItem>
      <TabItem Header="Shawzin Studio">
    <ScrollViewer>
      <Grid Margin="28" ColumnDefinitions="320,*" ColumnSpacing="28">
        <StackPanel Spacing="12">
          <Button Content="Open MIDI…" Click="OpenMidi_Click" />
          <TextBlock Text="Track" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="projects:MidiTrack"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Instrument" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="shawzin:ShawzinDefinition"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Scale" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" />
          <TextBlock Text="Arrangement strategy" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:StrategyChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Content="Analyze" Click="Analyze_Click" />
            <Button Grid.Column="1" Content="Arrange" Click="Arrange_Click" />
          </Grid>
          <Button Content="Save synthetic WAV preview…" IsEnabled="{Binding HasPreview}" Click="SavePreview_Click" />
          <Border Padding="12" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{DynamicResource SystemAccentColor}">
            <StackPanel Spacing="8">
              <TextBlock Text="Multi-Shawzin" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Number of Shawzins" />
              <ComboBox ItemsSource="{Binding ShawzinCounts}" SelectedItem="{Binding ShawzinCount}" />
              <TextBlock Text="Split strategy" />
              <ComboBox ItemsSource="{Binding SplitStrategies}" SelectedItem="{Binding SplitStrategy}" />
              <Button Content="Split and arrange ensemble" Click="SplitEnsemble_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="14">
          <TextBlock Text="Compatibility" FontSize="20" FontWeight="SemiBold" />
          <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="Generated Shawzin code" FontSize="20" FontWeight="SemiBold" />
          <TextBox Text="{Binding SongCode}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
          <Button Content="Copy code" HorizontalAlignment="Left" Click="CopyCode_Click" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75" />
          <TextBlock Text="Ensemble tracks" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EnsembleReport}" TextWrapping="Wrap" />
          <Expander Header="Split and arrangement report">
            <TextBox Text="{Binding EnsembleDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" />
          </Expander>
          <ListBox ItemsSource="{Binding EnsembleTracks}" SelectedItem="{Binding SelectedEnsembleTrack}" MaxHeight="420">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EnsembleTrackViewModel">
                <Border Padding="10" Margin="0,3" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding Instrument}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="shawzin:ShawzinDefinition"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:StrategyChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="Auto,80,Auto,Auto,*" ColumnSpacing="8">
                      <TextBlock Text="Transpose" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding Transposition}" />
                      <CheckBox Grid.Column="2" Content="Mute" IsChecked="{Binding IsMuted}" />
                      <CheckBox Grid.Column="3" Content="Solo" IsChecked="{Binding IsSolo}" />
                      <TextBlock Grid.Column="4" Text="{Binding Compatibility, StringFormat='Compatibility {0}/100'}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Report}" />
                    <TextBox Text="{Binding Code}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Padding="16" Margin="0,16,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemAccentColor}">
            <StackPanel Spacing="10">
              <TextBlock Text="Ingame Playback" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GameBridgeAvailability}" TextWrapping="Wrap" />
              <TextBlock Text="Keybind profile" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding KeybindProfiles}" SelectedItem="{Binding SelectedKeybindProfile}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="profiles:ShawzinKeybindProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox PlaceholderText="Profile name" Text="{Binding ProfileName}" />
              <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Text="String 1" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding String1Key}" />
                <TextBlock Grid.Column="2" Text="Fret Left" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding FretLeftKey}" />
                <TextBlock Grid.Row="1" Text="String 2" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding String2Key}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Fret Middle" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding FretMiddleKey}" />
                <TextBlock Grid.Row="2" Text="String 3" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding String3Key}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Fret Right" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding FretRightKey}" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Content="Save profile" Click="SaveProfile_Click" />
                <Button Grid.Column="1" Content="Duplicate" Click="DuplicateProfile_Click" />
                <Button Grid.Column="2" Content="Delete" Click="DeleteProfile_Click" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Content="Arm" Click="Arm_Click" />
                <Button Grid.Column="1" Content="Disarm" Click="Disarm_Click" />
                <Button Grid.Column="2" Content="Dry run" Click="DryRun_Click" />
              </Grid>
              <Button Content="Test input (diagnostic only)" Click="TestInput_Click" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Content="Start" Click="StartIngame_Click" />
                <Button Grid.Column="1" Content="Stop" Click="Disarm_Click" />
              </Grid>
              <Button Content="EMERGENCY STOP" Background="#B3261E" Foreground="White" Click="EmergencyStop_Click" />
              <TextBlock Text="Emergency Stop is always available here. Stop/errors/shutdown release all synthetic keys and disarm." TextWrapping="Wrap" />
              <TextBlock Text="{Binding GameBridgeStatus}" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
      </TabItem>
      <TabItem Header="Creator Mode">
        <views:CreatorModeView DataContext="{Binding CreatorMode}" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
