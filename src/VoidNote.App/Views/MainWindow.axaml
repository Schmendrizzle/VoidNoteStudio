<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VoidNote.App.Views.MainWindow"
        Title="{DynamicResource AppName}"
        Width="1000"
        Height="650"
        MinWidth="720"
        MinHeight="480">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,18" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource AppName}" FontSize="24" FontWeight="SemiBold" />
        <Border Grid.Column="1" Padding="12,6" CornerRadius="12"
                Background="{DynamicResource SystemAccentColor}">
          <TextBlock Text="{DynamicResource MilestoneLabel}" Foreground="White" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="48">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="14">
        <TextBlock Text="{DynamicResource FoundationHeading}"
                   FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{DynamicResource FoundationDescription}"
                   FontSize="16" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
